# Copy to an ignored .env file and fill in local values. Never commit .env.
# This contract is loaded explicitly by backend/src/hsm/config.py.

# Exact trusted browser origin. HTTP is permitted only for local loopback work.
PUBLIC_BASE_URL=http://localhost:8000
BIND_HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# Google Web OAuth client. Configure these locally; do not paste secrets in chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
BOOTSTRAP_ADMIN_EMAIL=

# Durable local state. The collector alone will open TinyFlux partitions.
DATABASE_PATH=./var/hsm.sqlite
TINYFLUX_DIR=./var/metrics
STATIC_DIR=./frontend/dist

# Local LXD. Inventory will cover all projects; creation targets this one.
LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
LXD_CREATE_PROJECT=hsm
LXD_TIMEOUT_SECONDS=10

# Selected bounded collection policy.
COLLECTOR_INTERVAL_SECONDS=10
COLLECTOR_STALE_SECONDS=30
METRICS_RETENTION_DAYS=7
METRICS_MAX_BYTES=268435456
