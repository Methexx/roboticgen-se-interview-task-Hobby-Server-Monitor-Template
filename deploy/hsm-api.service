[Unit]
Description=Hobby Server Monitor API
After=network.target

[Service]
User=hsm
WorkingDirectory=/opt/hsm/backend
EnvironmentFile=/etc/hsm/hsm.env
ExecStart=/opt/hsm/backend/.venv/bin/gunicorn --bind ${BIND_HOST}:${PORT} hsm.wsgi:app
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hsm

[Install]
WantedBy=multi-user.target
