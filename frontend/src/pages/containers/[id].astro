---
import Base from "../../layouts/Base.astro";
---
<Base title="Container details"><p id="status" aria-live="polite">Loading container…</p><section id="detail" hidden><h1 id="name"></h1><p id="meta"></p><div><button data-action="start">Start</button><button data-action="stop">Stop</button><button data-action="restart">Restart</button><button data-action="freeze">Freeze</button><button data-action="unfreeze">Unfreeze</button></div><form id="limits"><input name="ram_bytes" type="number" required/><input name="cpu_cores" type="number" required/><input name="cpu_allowance_pct" type="number" min="1" max="100" required/><input name="disk_bytes" type="number" required/><input name="process_limit" type="number" required/><button>Apply limits</button></form><form id="delete"><input name="confirm_name" placeholder="Type container name" required/><button>Delete container</button></form></section><script>import {api,json,ApiError} from "../../lib/api";const id=location.pathname.split('/').pop()!,s=document.querySelector('#status')!,d=document.querySelector<HTMLElement>('#detail')!,k=()=>crypto.randomUUID(),msg=(e:any)=>e instanceof ApiError&&e.status===403?'Forbidden.':e instanceof ApiError&&e.status===401?'Session expired.':e instanceof ApiError?e.message:'LXD is unavailable.';async function load(){try{const c=await api<any>(`/api/containers/${id}`);s.textContent='';d.hidden=false;document.querySelector('#name')!.textContent=c.name;document.querySelector('#meta')!.textContent=`${c.project} · ${c.state??'snapshot stale'}`;}catch(e){s.textContent=msg(e)}}document.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',async()=>{try{await api(`/api/containers/${id}/actions/${(b as HTMLElement).dataset.action}`,{method:'POST',headers:{'Idempotency-Key':k()}});load()}catch(e){s.textContent=msg(e)}}));document.querySelector<HTMLFormElement>('#limits')!.addEventListener('submit',async e=>{e.preventDefault();const f=new FormData(e.currentTarget);try{await api(`/api/containers/${id}/limits`,{...json('PATCH',Object.fromEntries([...f].map(([a,b])=>[a,+b]))),headers:{'Content-Type':'application/json','Idempotency-Key':k()}});load()}catch(e){s.textContent=msg(e)}});document.querySelector<HTMLFormElement>('#delete')!.addEventListener('submit',async e=>{e.preventDefault();try{await api(`/api/containers/${id}`,{...json('DELETE',{confirm_name:new FormData(e.currentTarget).get('confirm_name')}),headers:{'Content-Type':'application/json','Idempotency-Key':k()}});location.href='/containers'}catch(e){s.textContent=msg(e)}});load();</script></Base>