[Unit]
Description=Hobby Server Monitor collector
After=lxd.service

[Service]
User=hsm
WorkingDirectory=/opt/hsm/backend
EnvironmentFile=/etc/hsm/hsm.env
ExecStart=/opt/hsm/backend/.venv/bin/python -m hsm.collector
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hsm

[Install]
WantedBy=multi-user.target
