---
import Base from "../layouts/Base.astro";

const states = {
  loading: ["Loading inventory", "Waiting for the authenticated snapshot API."],
  empty: ["No containers yet", "Create or discover a container to populate this dashboard."],
  stale: ["Snapshot is stale", "Showing the last saved data while the collector is unavailable."],
  error: ["Dashboard unavailable", "The snapshot API returned an error. Retry after checking service status."],
} as const;
type State = keyof typeof states;
---

<Base title="Dashboard">
  <header>
    <p class="muted">Authenticated dashboard placeholder</p>
    <h1>Container inventory</h1>
  </header>
  {Object.entries(states).map(([state, [heading, detail]]) => (
    <section class="card state" aria-live="polite" data-dashboard-state={state} hidden={state !== "loading"}>
      <h2>{heading}</h2>
      <p>{detail}</p>
    </section>
  ))}
  <nav aria-label="Preview dashboard state">
    {Object.keys(states).map((name) => <a href={`/dashboard?state=${name}`}>{name}</a>)}
  </nav>
  <p><a href="/">Back to sign in</a></p>
  <script>
    const allowed = new Set(["loading", "empty", "stale", "error"]);
    const requested = new URLSearchParams(window.location.search).get("state");
    const selected = requested && allowed.has(requested) ? requested : "loading";
    document.querySelectorAll<HTMLElement>("[data-dashboard-state]").forEach((element) => {
      element.hidden = element.dataset.dashboardState !== selected;
    });
  </script>
</Base>
