---
import Base from "../layouts/Base.astro";
---
<Base title="Dashboard">
  <p class="muted">Container User dashboard</p><h1>My containers</h1>
  <p id="dashboard-state" class="state" aria-live="polite">Loading snapshots…</p>
  <section id="quota" class="card" hidden><h2>My budget</h2><p></p></section>
  <section class="card"><h2>Assigned containers</h2><div id="containers"></div></section>
  <section class="card"><h2>History and accounting</h2><p id="history-state">Select a container to load up to 300 historical points. Snapshot state reports stale, partial, or LXD-down collection.</p></section>
  <p><a href="/users">Manage users</a> (admins only)</p>
  <script>
    import { api, ApiError } from "../lib/api";
    const state = document.querySelector<HTMLElement>("#dashboard-state")!;
    const quota = document.querySelector<HTMLElement>("#quota")!;
    const list = document.querySelector<HTMLElement>("#containers")!;
    async function load() { try {
      const [budget, containers] = await Promise.all([api<any>("/api/me/quota"), api<{items:any[]}>("/api/containers")]);
      quota.hidden = false; quota.querySelector("p")!.textContent = `Quota ${JSON.stringify(budget.quota)}; allocated ${JSON.stringify(budget.allocated)}; remaining ${JSON.stringify(budget.remaining)}`;
      if (!containers.items.length) { state.textContent = "No containers are assigned to you."; return; }
      state.textContent = containers.items.some((item) => item.error_code) ? "Snapshot may be stale or partial." : "";
      list.replaceChildren(...containers.items.map((item) => { const article = document.createElement("article"); article.className = "card"; article.textContent = `${item.name} (${item.project}) — ${item.state ?? "No snapshot"}`; return article; }));
    } catch (error) { state.textContent = error instanceof ApiError && error.status === 401 ? "Session expired. Sign in again." : error instanceof ApiError && error.status === 403 ? "Forbidden: you do not have access." : "The snapshot API is unavailable. Try again later."; } }
    load();
  </script>
</Base>
